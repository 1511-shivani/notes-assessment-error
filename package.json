{
  "name": "notes-app-playwright-assessment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:integration": "playwright test --project=integration",
    "test:mocks": "playwright test --project=mocks",
    "test:live": "playwright test --project=ui --project=api --project=integration",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
